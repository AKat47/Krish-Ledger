# Copy this to .env and fill in your values
# Get your MongoDB URI from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/krishiledger?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
# Set a random secret string for JWT (optional, for future auth)
JWT_SECRET=your_random_secret_here_change_this
# Frontend URL for CORS (your Vercel URL after deploy)
FRONTEND_URL=http://localhost:3000
